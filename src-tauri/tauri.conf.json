{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oberon",
  "version": "0.2.9",
  "identifier": "com.localmusicplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oberon",
        "width": 1267,
        "height": 902,
        "minWidth": 1152,
        "minHeight": 768,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCRkVBRkQ4RDE5QUUyMTIKUldRUzRwclIySy8rUzVvcGQ1R2tmcnphbWkvK3B4M2ZWd0lqbmxMZGlOT0g2NldTR0Q3YUlXSFkK",
      "endpoints": [
        "https://github.com/ajusbaby/Oberon-Music/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
